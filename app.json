{
  "expo": {
    "name": "WellShe",
    "scheme": "wellshe",
    "slug": "wellshe",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/logo/wellshe_icon_1024.png",
    "userInterfaceStyle": "light",

    "splash": {
      "image": "./assets/images/splash_big.png",
      "resizeMode": "contain",
      "backgroundColor": "#fdf1e6"
    },

    "assetBundlePatterns": ["**/*"],

    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/4875fac3-fcb7-478f-be18-25febe55c294"
    },

    "runtimeVersion": {
      "policy": "appVersion"
    },

    "ios": {
      "bundleIdentifier": "com.feraye.wellshe",
      "supportsTablet": true
    },

    "android": {
      "package": "com.feraye.wellshe",
      "versionCode": 5,
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
     ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo/wellshe_icon_1024.png",
        "backgroundColor": "#ffffff"
      }
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
  "./plugins/withAndroidQueries",
  "expo-secure-store",
  "expo-notifications",
  [
    "react-native-google-mobile-ads",
    {
      "androidAppId": "ca-app-pub-9133000462142645~5704575558",
      "iosAppId": "ca-app-pub-3940256099942544~1458002511"
    }
  ]
],

    "extra": {
      "eas": {
        "projectId": "4875fac3-fcb7-478f-be18-25febe55c294"
      }
    },

    "owner": "wellshe"
  }
}
