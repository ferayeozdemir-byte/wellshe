{
  "expo": {
    "name": "WellShe",
    "scheme": "wellshe",
    "slug": "wellshe",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/logo/wellshe_icon_1024.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash_big.png",
      "resizeMode": "contain",
      "backgroundColor": "#fdf1e6"
    },
    "assetBundlePatterns": ["**/*"],
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/4875fac3-fcb7-478f-be18-25febe55c294"
    },
    "runtimeVersion": "1.0.3",
    "newArchEnabled": true,

    "ios": {
      "bundleIdentifier": "com.feraye.wellshe",
      "supportsTablet": true,
      "config": {
        "googleMobileAdsAppId": "ca-app-pub-3940256099942544~1458002511"
      }
    },

    "android": {
      "package": "com.feraye.wellshe",
      "versionCode": 21,
      "permissions": ["com.google.android.gms.permission.AD_ID"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo/wellshe_icon_1024.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMobileAdsAppId": "ca-app-pub-9133000462142645~5704575558"
      }
    },

    "plugins": [
      "./plugins/withAndroidQueries",
      "expo-secure-store",
      "expo-notifications",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "wellshe"
        }
      ]
    ],

    "extra": {
      "eas": { "projectId": "4875fac3-fcb7-478f-be18-25febe55c294" }
    },
    "owner": "wellshe"
  }
}
